{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tinhdiemthpt",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-21",
  "workers_dev": true,
  "vars": {
    "ADSENSE_CLIENT": "ca-pub-5701300811077965",
    "ADSENSE_ENABLED": "true",
    "ADSENSE_CMP_READY": "true"
  },
  "routes": [
    {
      "pattern": "tinhdiemthpt.id.vn",
      "custom_domain": true
    }
  ],
  "keep_vars": true,
  "assets": {
    "directory": "./.cloudflare/public",
    "binding": "ASSETS",
    "run_worker_first": ["/","/index.html","/cam-nang/*","/privacy","/privacy.html","/gioi-thieu/*","/lien-he/*","/dieu-khoan-su-dung/*","/nguon-du-lieu-va-bao-sai/*","/ads.txt","/api/*","/_worker-data/*","/vendor/tesseract/worker.min.js","/tinh-diem-thpt","/tinh-diem-thpt/*","/tinh-diem-hoc-ba","/tinh-diem-hoc-ba/*","/cong-thuc-xet-tuyen","/cong-thuc-xet-tuyen/*","/to-hop-mon","/to-hop-mon/*","/ho-so-truong","/ho-so-truong/*","/tim-nganh","/tim-nganh/*","/phong-thi","/phong-thi/*","/huong-dan","/huong-dan/*","/truong/*","/nganh/*"]
  },
  "services": [
    {
      "binding": "OCR_SERVICE",
      "service": "tinhdiemthpt-ocr"
    }
  ],
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "tinhdiemthpt-auth",
      "database_id": "ca54ca27-e706-4bc6-8d9f-11614f938eaa",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "OCR_RATE_LIMITER",
      "namespace_id": "41001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "REPORT_RATE_LIMITER",
      "namespace_id": "41002",
      "simple": { "limit": 3, "period": 60 }
    },
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "41003",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "41004",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
