{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tinhdiemthpt-ocr",
  "main": "worker/ocr.js",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "placement": {
    "region": "gcp:us-east4"
  },
  "workers_dev": false,
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
