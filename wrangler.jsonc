{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tinhdiemthpt",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-21",
  "workers_dev": true,
  "keep_vars": true,
  "assets": {
    "directory": "./.cloudflare/public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/_worker-data/*"]
  },
  "services": [
    {
      "binding": "OCR_SERVICE",
      "service": "tinhdiemthpt-ocr"
    }
  ],
  "ratelimits": [
    {
      "name": "OCR_RATE_LIMITER",
      "namespace_id": "41001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "REPORT_RATE_LIMITER",
      "namespace_id": "41002",
      "simple": { "limit": 3, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
