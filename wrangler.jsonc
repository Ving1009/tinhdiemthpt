{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tinhdiemthpt",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-21",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "tinhdiemthpt.id.vn",
      "custom_domain": true
    }
  ],
  "keep_vars": true,
  "assets": {
    "directory": "./.cloudflare/public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/api/*", "/_worker-data/*"]
  },
  "services": [
    {
      "binding": "OCR_SERVICE",
      "service": "tinhdiemthpt-ocr"
    }
  ],
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "tinhdiemthpt-auth",
      "database_id": "ca54ca27-e706-4bc6-8d9f-11614f938eaa",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "OCR_RATE_LIMITER",
      "namespace_id": "41001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "REPORT_RATE_LIMITER",
      "namespace_id": "41002",
      "simple": { "limit": 3, "period": 60 }
    },
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "41003",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "41004",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
