GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
# Cũng có thể dùng một dòng, ngăn cách bằng dấu phẩy: GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash-lite

OCR_SPACE_API_KEY_1=
OCR_SPACE_API_KEY_2=
OCR_SPACE_API_KEY_3=
OCR_SPACE_API_KEY_4=
OCR_SPACE_API_KEY_5=
# Cũng có thể dùng một dòng, ngăn cách bằng dấu phẩy: OCR_SPACE_API_KEYS=
OCR_SPACE_ENDPOINT=https://api.ocr.space/parse/image
OCR_SPACE_ENGINE=2
OCR_SPACE_MAX_IMAGE_BYTES=1048576
OCR_SPACE_TIMEOUT_MS=60000

# Groq cho trợ lý tuyển sinh và quét học bạ. Khóa chỉ dùng ở backend/Cloudflare Worker.
GROQ_API_KEY_1=
# Có thể bổ sung GROQ_API_KEY_2..5 hoặc một dòng GROQ_API_KEYS=key1,key2
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=20000
# Model nhận ảnh riêng; không đổi GROQ_MODEL của trợ lý tư vấn.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_VISION_TIMEOUT_MS=45000

# Cloudflare Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WORKERS_AI_API_KEY_1=
CLOUDFLARE_WORKERS_AI_API_KEY_2=
CLOUDFLARE_WORKERS_AI_API_KEY_3=
CLOUDFLARE_WORKERS_AI_API_KEY_4=
CLOUDFLARE_WORKERS_AI_API_KEY_5=
CLOUDFLARE_AI_MODEL=@cf/openai/gpt-oss-20b
CLOUDFLARE_AI_TIMEOUT_MS=20000

# Mistral
MISTRAL_API_KEY_1=
MISTRAL_API_KEY_2=
MISTRAL_API_KEY_3=
MISTRAL_API_KEY_4=
MISTRAL_API_KEY_5=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_TIMEOUT_MS=20000

# OpenRouter Free Models Router
OPENROUTER_API_KEY_1=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TIMEOUT_MS=30000

PORT=3000
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_REPORTS_TABLE=data_reports
SUPABASE_TIMEOUT_MS=10000
SUPABASE_SYNC_INTERVAL_MS=300000

# Cloudflare Turnstile: site key có thể công khai; secret key chỉ lưu ở máy chủ/Cloudflare Secrets.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Tùy chọn, ngăn cách bằng dấu phẩy. Để trống sẽ kiểm tra đúng hostname của request.
TURNSTILE_ALLOWED_HOSTNAMES=
